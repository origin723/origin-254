# Copy to .env and adjust
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://localhost:5432/origin254
# Notification channels: comma separated subset of in_app,email,sms,whatsapp
NOTIFICATION_CHANNELS=in_app,email,sms
# SMS / WhatsApp provider: console (logs only), africastalking, twilio
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Origin 254 <no-reply@origin254.example>
# 1 = new accounts wait for admin approval; 0 = approved at registration
REQUIRE_ACCOUNT_VERIFICATION=0

# --- Payments (M-Pesa) ---
# simulated = test mode, no money moves. mpesa = Safaricom Daraja (sandbox or production).
PAYMENT_PROVIDER=simulated
# How suppliers are paid after the buyer confirms delivery: manual, simulated or mpesa (B2C)
PAYOUT_PROVIDER=manual
# Origin 254 commission on every sale; the seller receives the rest
PLATFORM_FEE_PERCENT=10
REQUIRE_PAYMENT_BEFORE_DISPATCH=0
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_TILL_OR_PAYBILL=
# Public HTTPS address of this site that Safaricom can call, e.g. https://origin254.example.com
MPESA_CALLBACK_BASE_URL=
# Long random secret; becomes part of the callback URL. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
MPESA_CALLBACK_TOKEN=
MPESA_B2C_SHORTCODE=
MPESA_B2C_INITIATOR=
MPESA_B2C_SECURITY_CREDENTIAL=
# Object storage for uploaded files (S3-compatible: PrimeCloud Storage / Cloudflare R2 / AWS S3).
# Leave S3_BUCKET empty to store uploads on local disk in PRIVATE_MEDIA_ROOT.
S3_BUCKET=
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_PREFIX=private_media
